# Copy to .env.local for development. NEVER commit real secrets.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development

# Public base URL of the neutral marketplace (used for OG tags, links, cookies).
PUBLIC_BASE_URL=http://localhost:3000

# Postgres — matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgres://hodorhub:hodorhub@localhost:5432/hodorhub

# Integration tests TRUNCATE all tables — point at a DISPOSABLE database, never
# one with real data. Falls back to DATABASE_URL if unset.
#   createdb via: docker compose exec db createdb -U hodorhub hodorhub_test
TEST_DATABASE_URL=postgres://hodorhub:hodorhub@localhost:5432/hodorhub_test

# 32-byte base64 key for AES-256-GCM encryption of stored OAuth tokens (see src/lib/crypto.ts).
APP_ENCRYPTION_KEY=

# Secret used to sign session cookies.
SESSION_SECRET=

# SMTP (dev: MailHog on localhost:1025 needs no auth). Swap for a free-tier provider in prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HodorHub <no-reply@hodorhub.local>"

# Social ingestion (Release 1). Leave blank until the apps are registered.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
